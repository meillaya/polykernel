   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "t = max(FLOPs / peak, bytes / BW) / eta\n\nscalar baseline   eta = 0.12\ntuned variant      eta = 0.35\n\n0.35 / 0.12 = 2.92",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "r4",
   "originalText": "t = max(FLOPs / peak, bytes / BW) / eta\n\nscalar baseline   eta = 0.12\ntuned variant      eta = 0.35\n\n0.35 / 0.12 = 2.92",
   "lineHeight": 1.25,
   "baseline": 17
  },
  {
