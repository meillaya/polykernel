//===- PolyKernelDialect.td - PolyKernel dialect -----------*- tablegen -*-===//
//
// PolyKernel out-of-tree MLIR dialect: dialect declaration.
//
//===----------------------------------------------------------------------===//
//
// This file declares ONLY the dialect record (name, namespace). The dialect's
// operations are defined in PolyKernelOps.td (Todo 3); the dialect decl is kept
// separate so PolyKernelDialect.{h,cpp}.inc and PolyKernelOps.{h,cpp}.inc are
// generated by independent TableGen targets (no double-generation).
//
//===----------------------------------------------------------------------===//

#ifndef POLYKERNEL_DIALECT
#define POLYKERNEL_DIALECT

include "mlir/IR/OpBase.td"

//===----------------------------------------------------------------------===//
// PolyKernel dialect definition.
//===----------------------------------------------------------------------===//

def PolyKernel_Dialect : Dialect {
  let name = "polykernel";
  let summary = "PolyKernel out-of-tree dialect for transformer inference.";
  let description = [{
    The PolyKernel dialect. It carries a closed set of transformer-inference
    operations (base + fused) defined in PolyKernelOps.td. The dialect does not
    allow unknown operations, so any op outside the named set fails to parse.
  }];
  let cppNamespace = "::mlir::polykernel";
}

#endif // POLYKERNEL_DIALECT
