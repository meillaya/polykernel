=== STEP 1: polykernel-opt --lower-to-cuda emits both fused .cu (byte-identical) ===
--- input IR (both fused ops) ---
polykernel.func @fused_both(%x: tensor<128x128xbf16>, %w: tensor<128x128xbf16>,
                            %a: tensor<128x128xbf16>, %b: tensor<128x128xbf16>,
                            %bias: tensor<128xbf16>) -> tensor<128x128xbf16> {
  %0 = polykernel.fused_rmsnorm_matmul %x, %w {epsilon = 1.0e-05 : f32}
      : tensor<128x128xbf16>, tensor<128x128xbf16> -> tensor<128x128xbf16>
  %1 = polykernel.fused_matmul_bias_gelu %a, %b, %bias
      : tensor<128x128xbf16>, tensor<128x128xbf16>, tensor<128xbf16> -> tensor<128x128xbf16>
  %2 = polykernel.add %0, %1 : tensor<128x128xbf16>
  polykernel.return %2 : tensor<128x128xbf16>
}
