=== STEP 1: polykernel-opt --lower-to-cuda emits matmul.cu + softmax.cu ===
--- input IR (matmul + softmax) ---
polykernel.func @mm_sm(%a: tensor<128x128xbf16>, %b: tensor<128x128xbf16>) -> tensor<128x128xbf16> {
  %0 = polykernel.matmul %a, %b : tensor<128x128xbf16>, tensor<128x128xbf16> -> tensor<128x128xbf16>
  %1 = polykernel.softmax %0 : tensor<128x128xbf16>
  polykernel.return %1 : tensor<128x128xbf16>
}
