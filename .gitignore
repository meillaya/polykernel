# --- PolyKernel build / toolchain artifacts ---

# Stale codegraph index symlink (NEVER commit or delete; leave in place).
# No trailing slash: .codegraph is a symlink, so a dir-only pattern won't match.
.codegraph
.codegraph/

# CMake / Ninja build outputs
build/
# Task-local build dirs (Wave 8+ parallel verification: build_verify/, build_tNN/).
build_*/
result
result-*

# devenv.sh / direnv state
.devenv*
.direnv/

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Compiled objects / build artifacts
*.o
*.obj
*.so
*.a
*.cubin
*.ptx
*.fatbin
*.bc
*.out
a.out

# Caches
.cache/
cache/

# Orchestration state (Atlas / OhMyOpenCode) - not part of the product
.omo/

# --- Security: SSH keys (Prime Intellect pod) ---
# SSH keys for the Prime Intellect pod - NEVER commit
*.pem
