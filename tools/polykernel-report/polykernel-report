#!/usr/bin/env python3
"""Thin executable wrapper for the PolyKernel traffic report (Todo 17 / Wave 3).

Lets the QA command run without a `python` prefix:

    polykernel-report --traffic examples/mlp_block.mlir

Equivalent to:

    python tools/polykernel-report/traffic_report.py --traffic examples/mlp_block.mlir
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from traffic_report import main

if __name__ == "__main__":
    raise SystemExit(main())
